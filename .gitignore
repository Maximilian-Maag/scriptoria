# Patterns here are deliberately NOT root-anchored. This is a pnpm workspace, so
# node_modules, .next and dist exist under apps/* and packages/* as well as at
# the root — a leading slash would ignore only the root copy and commit the rest.
#
# And deliberately without a trailing slash on the two a developer *links*:
# `node_modules/` matches a directory named node_modules and nothing else, so a
# worktree that shares the checkout's dependencies with
#
#   ln -s ~/scriptoria/node_modules node_modules
#
# commits that symlink, and the CI checkout then has a *file* called
# node_modules — every job dies with `ENOTDIR: not a directory, mkdir
# …/node_modules` before it runs a single step.

# dependencies
node_modules
.pnp
.pnp.js

# build output
.next
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.turbo/

# testing
coverage/
# Stryker's sandbox — a copy of the package it mutates, rewritten for every mutant
.stryker-tmp/
playwright-report/
test-results/
# Where the e2e global setup records the runner it started, for the teardown.
.playwright/
.vitest/

# local env files — .env.example IS tracked and is the documented template
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# generated architecture diagrams — the model in workspace.dsl is the source of truth
/docs/architecture/diagrams/
/.diagrams/

# dev fixture SSH key — generated by `make fixtures-key`, accepted only by the dev sshd
/infra/sshd/keys/
/infra/sshd/authorized_keys

# terraform — provider plugins and state. The state is the deployment's, not the
# repository's: it lives in the backend the operator configures at init, and
# anything a local run leaves behind is a working file.
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/checks/host_prep/host.yaml

# structurizr lite working files — it writes workspace.json next to the DSL as
# its own cache. workspace.dsl is the source of truth; a checked-in render of it
# is a render that will disagree with it.
/docs/architecture/.structurizr/
/docs/architecture/workspace.json
