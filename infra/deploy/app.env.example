# Scriptoria — the deployment's configuration, in one list.
#
# Not here: the values that differ between machines of the same role. A control-plane
# process's port and the address a store publishes on live in
# /etc/scriptoria/<unit>.env — see docs/guides/deployment.md, which is also where the
# trap in BIND_ADDRESS is written down.
#
# NOT a file in the repository. On a host it lives at /etc/scriptoria/app.env,
# root-owned and 0600, and systemd hands it to each container through the
# credential store (LoadCredential in ../systemd/) rather than leaving a path that
# any process on the machine could wander into.
#
# It is one file rather than one per process because these values describe one
# deployment and are read by all of its parts: the applications' settings and the
# bootstrap variables the data containers read are in the same place, which is what
# lets check-env.sh fail when they disagree instead of letting a deployment
# discover it as "password authentication failed" at first login.
#
# The one gotcha, and it is the one that costs an afternoon: **a container's
# localhost is not the host.** Where a service is another container on the same
# instance, the host in these URLs is the CONTAINER NAME; where it is a different
# instance — the data instance, the directory, the script VM — it is that
# instance's VPC address. check-env.sh rejects 127.0.0.1 and localhost here for
# exactly that reason; the development list in the repository root is the one
# where localhost is right.

# ── Shared ────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
SERVICE_NAME=scriptoria

# ── Frontend ──────────────────────────────────────────────────────────────────
# Server-to-server, inside the podman network. The frontend and the control plane
# are on the same instance in every environment, so this is the container's name.
# One line per control-plane process, load-balanced by the proxy in front.
BACKEND_INTERNAL_URL=http://scriptoria-backend-1:3001
# The proxy terminates TLS and appends the client address, so the last entry of
# x-forwarded-for is the address that is recorded in the audit trail (FA-12.1).
TRUSTED_REVERSE_PROXY=true
# The terminal socket's address is compiled into the browser bundle at build time
# (`NEXT_PUBLIC_TERMINAL_WS_URL` as a build argument), NOT read here — see
# ADR-010. It is wss://<public host>, and the path is appended by the client.
FRONTEND_PORT=3000

# ── Control plane ─────────────────────────────────────────────────────────────
BACKEND_PORT=3001
DATABASE_URL=postgres://scriptoria:CHANGEME@scriptoria-postgres:5432/scriptoria
DATABASE_POOL_MAX=10
CATALOG_CACHE_TTL_SECONDS=60

# ── PostgreSQL container ──────────────────────────────────────────────────────
# The image's own bootstrap variables. They must agree with DATABASE_URL above —
# same password, same database — and check-env.sh compares them.
POSTGRES_DB=scriptoria
POSTGRES_USER=scriptoria
POSTGRES_PASSWORD=CHANGEME

# ── Redis — sessions, run streams, job queue ──────────────────────────────────
REDIS_URL=redis://scriptoria-redis:6379
STREAM_MAXLEN=50000
STREAM_TTL_SECONDS=86400

# ── Directory ─────────────────────────────────────────────────────────────────
# NFR-02 is LDAPS, and this file is the deployment: the scheme is checked. TLS to
# the directory is that host's business (its own certificate, or a terminating
# proxy in front of it) and the platform only requires the scheme.
LDAP_URL=ldaps://scriptoria-openldap:1636
LDAP_BASE_DN=dc=example,dc=org
LDAP_USER_DN_TEMPLATE=cn={username},ou=users,dc=example,dc=org
# The read-only account used for group resolution. It never authenticates anybody:
# a user proves who they are by binding with their own credentials.
LDAP_BIND_DN=cn=service,dc=example,dc=org
LDAP_BIND_PASSWORD=CHANGEME
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=org
LDAP_GROUP_FILTER=(&(objectClass=groupOfNames)(member={userDn}))
# On, and it means it. A deployment with TLS verification off is a deployment
# where the group a user is in is whatever a machine in the middle says it is.
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TIMEOUT_MS=10000

# ── OpenLDAP container ────────────────────────────────────────────────────────
# The image's bootstrap variables, describing the same directory as the block
# above: LDAP_ROOT is LDAP_BASE_DN, and the admin password is the bind password
# until the directory has enough accounts to warrant a separate one.
LDAP_ROOT=dc=example,dc=org
LDAP_ADMIN_USERNAME=admin
LDAP_ADMIN_PASSWORD=CHANGEME
LDAP_CUSTOM_LDIF_DIR=/ldifs

# ── Sessions ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=scriptoria.sid
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
# Never off behind TLS.
SESSION_COOKIE_SECURE=true

# ── Runner ────────────────────────────────────────────────────────────────────
RUNNER_CONCURRENCY=4
# Empty on purpose: the runner derives `<hostname>:<pid>`, which is unique by
# construction, and two workers sharing an id would claim one run twice.
RUNNER_ID=
SSH_PRIVATE_KEY_PATH=/etc/scriptoria/ssh/id_ed25519
SSH_PRIVATE_KEY_PASSPHRASE=
SSH_KNOWN_HOSTS_PATH=/etc/scriptoria/ssh/known_hosts
SSH_SKIP_HOST_KEY_VERIFICATION=false
SSH_CONNECT_TIMEOUT_MS=15000
SSH_KEEPALIVE_INTERVAL_MS=15000
PTY_COLS=80
PTY_ROWS=24

# Staged abort (ADR-003). The defaults are in packages/config; they are stated
# here only so that the escalation a modifying script gets is a deployment
# decision rather than a library default.
ABORT_SIGINT_GRACE_MS=5000
ABORT_SIGTERM_GRACE_MS=10000
