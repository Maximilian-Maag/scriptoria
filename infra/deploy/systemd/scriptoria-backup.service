# Scriptoria — the database backup.
#
# Run by scriptoria-backup.timer, and also by hand before a release that changes
# the schema. It is a one-shot container rather than a cron entry on the host, so
# that the tool doing the dumping is the same PostgreSQL that is being dumped.

[Unit]
Description=Scriptoria database backup
Documentation=https://github.com/Maximilian-Maag/scriptoria
# `After` rather than `Requires`: a requirement would pull PostgreSQL up on a host that
# is not the data instance, so an app instance whose timer fired would start a store it
# was never meant to run. The guard in ExecCondition is the honest version — back up if
# there is a store on this machine, and skip quietly if there is not.
After=scriptoria-postgres.service

[Service]
Type=oneshot
User=scriptoria
Group=scriptoria

Environment=XDG_RUNTIME_DIR=/run/user/%U
Delegate=yes

# The timer is enabled on every host, because deciding which host is the data instance is
# the operator's business and a backup nobody remembered to switch on is a backup that
# does not exist. Where there is no store container the unit skips rather than fails: a
# unit that reports a failure every day on three machines out of five is a unit whose
# failures stop being read.
#
# A store that exists but is stopped is not skipped — the dump then fails and says so,
# which is the right amount of noise for a backup that did not happen.
ExecCondition=/usr/bin/podman container exists scriptoria-postgres

EnvironmentFile=-/etc/scriptoria/%N.env
LoadCredential=app.env:/etc/scriptoria/app.env

ExecStartPre=-/usr/bin/podman rm --force --ignore %N
ExecStart=/usr/bin/podman run \
  --rm \
  --name %N \
  --pull=never \
  --network=scriptoria \
  --env-file=%d/app.env \
  --volume /var/lib/scriptoria/backups:/backups:Z \
  --volume /etc/scriptoria/backup.sh:/backup.sh:ro \
  --entrypoint /bin/sh \
  --detach=false \
  --log-driver=journald \
  postgres:16-alpine \
  /backup.sh
TimeoutStartSec=1800

NoNewPrivileges=yes
