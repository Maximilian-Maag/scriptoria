{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.stryker.config.ts",
    "related": false
  },
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/crontab.ts",
    "!src/scriptReference.ts"
  ],
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "/tmp/stryker-core.json" },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 85
  }
}
