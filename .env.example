# Copy to .env and adjust. Every variable here has a default in
# packages/config that matches the dev stack in infra/docker-compose.dev.yml,
# so a local checkout runs with an empty .env — the file exists so that the
# deployment has one list to fill in rather than three.
#
# Nothing in this file is a secret. The real values live in the systemd
# credential store on the host, not in a checked-out file.

# ── Shared ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=scriptoria

# ── Frontend (:3000) ──────────────────────────────────────────────────────────
FRONTEND_PORT=3000
# Server-to-server only; the browser never sees this address.
BACKEND_INTERNAL_URL=http://localhost:3001
# The browser DOES see this: the terminal socket bypasses the proxy (ADR-007).
NEXT_PUBLIC_TERMINAL_WS_URL=ws://localhost:3001
PROXY_TIMEOUT_MS=30000

# ── Backend (:3001) ───────────────────────────────────────────────────────────
BACKEND_PORT=3001
BACKEND_PUBLIC_ORIGIN=http://localhost:3001
DATABASE_URL=postgres://postgres:postgres@localhost:5433/scriptoria
DATABASE_POOL_MAX=10
CATALOG_CACHE_TTL_SECONDS=60

# ── Redis — sessions, run streams, job queue ──────────────────────────────────
REDIS_URL=redis://localhost:6379
STREAM_MAXLEN=50000
STREAM_TTL_SECONDS=86400

# ── Directory ─────────────────────────────────────────────────────────────────
# NFR-02 is LDAPS in production. The dev fixture speaks plain LDAP on 1389,
# so TLS verification is off here and ON everywhere else.
LDAP_URL=ldap://localhost:1389
LDAP_BASE_DN=dc=scriptoria,dc=test
LDAP_USER_DN_TEMPLATE=cn={username},ou=users,dc=scriptoria,dc=test
LDAP_BIND_DN=cn=admin,dc=scriptoria,dc=test
LDAP_BIND_PASSWORD=adminpassword
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=scriptoria,dc=test
LDAP_GROUP_FILTER=(&(objectClass=groupOfNames)(member={userDn}))
LDAP_TLS_REJECT_UNAUTHORIZED=false
LDAP_TIMEOUT_MS=10000

# ── Sessions ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=scriptoria.sid
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
# Off only because development is plain http. Never off behind TLS.
SESSION_COOKIE_SECURE=false

# ── Runner ────────────────────────────────────────────────────────────────────
RUNNER_CONCURRENCY=4
RUNNER_ID=
SSH_PRIVATE_KEY_PATH=infra/sshd/keys/id_ed25519
SSH_PRIVATE_KEY_PASSPHRASE=
SSH_KNOWN_HOSTS_PATH=infra/sshd/known_hosts
# The fixture regenerates its host key on every image build. Dev only.
SSH_SKIP_HOST_KEY_VERIFICATION=true
SSH_CONNECT_TIMEOUT_MS=15000
SSH_KEEPALIVE_INTERVAL_MS=15000
PTY_COLS=80
PTY_ROWS=24
# Staged abort (ADR-003): SIGINT, wait, SIGTERM, wait, SIGKILL.
ABORT_SIGINT_GRACE_MS=5000
ABORT_SIGTERM_GRACE_MS=10000
