{
  "name": "scriptoria",
  "version": "0.1.0",
  "private": true,
  "description": "Web frontend for selecting, running, interactively driving and collecting the results of existing Linux scripts on remote service VMs.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r --parallel exec tsc --noEmit",
    "test": "pnpm -r --filter '!e2e' test",
    "test:watch": "pnpm -r --parallel --filter '!e2e' test:watch",
    "test:e2e": "pnpm --filter e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
