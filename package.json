{
  "name": "scriptoria",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maximilian-Maag/scriptoria"
  },
  "version": "0.1.0",
  "private": true,
  "description": "Web frontend for selecting, running, interactively driving and collecting the results of existing Linux scripts on remote service VMs.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r --parallel exec tsc --noEmit",
    "test": "pnpm -r --filter '!e2e' test",
    "test:watch": "pnpm -r --parallel --filter '!e2e' test:watch",
    "test:e2e": "pnpm --filter e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
